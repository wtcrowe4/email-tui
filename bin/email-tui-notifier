#!/usr/bin/env python3
"""Keeps herdr's $mail and $career tokens current and shows toasts on new mail.

The badges go only on the workspace named by EMAIL_TUI_WORKSPACE (default
"Messages"). Toasts show sender display names, never subjects or bodies.
Career mail also raises a desktop alert that stays until dismissed.
"""

import fcntl
import json
import os
import queue
import subprocess
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "bridge"))

from email_tui_bridge.client import BridgeError, call, events

HERDR = os.environ.get("HERDR_BIN_PATH", "herdr")
WORKSPACE = os.environ.get("EMAIL_TUI_WORKSPACE", "Messages")
SOURCE = "wtcrowe4.email-tui"
TOKENS = ("mail", "career")
REFRESH_SECONDS = 60
RETRY_SECONDS = 30
MAX_HERDR_FAILURES = 3


def herdr(*args: str) -> str | None:
    try:
        done = subprocess.run([HERDR, *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout if done.returncode == 0 else None


def workspaces() -> list[dict] | None:
    output = herdr("workspace", "list")
    if output is None:
        return None
    return json.loads(output)["result"]["workspaces"]


def wanted_tokens(mail: int | None, career: int | None) -> dict[str, str | None]:
    return {
        "mail": f"✉ {mail}" if mail else None,
        "career": f"★ {career}" if career else None,
    }


def badge_calls(spaces: list[dict], wanted: dict[str, str | None]) -> list[list[str]]:
    """herdr calls that put the tokens on the mail workspace and clear them elsewhere."""
    calls = []
    for space in spaces:
        mine = space.get("label", "").casefold() == WORKSPACE.casefold()
        current = space.get("tokens") or {}
        for name in TOKENS:
            value = wanted[name] if mine else None
            if current.get(name) == value:
                continue
            base = ["workspace", "report-metadata", space["workspace_id"], "--source", SOURCE]
            calls.append([*base, "--token", f"{name}={value}"] if value else [*base, "--clear-token", name])
    return calls


def toast(event: dict, names: dict[str, str]) -> tuple[str, str, bool]:
    """Title, body and whether this is career mail."""
    where = names.get(event.get("account"), "Mail")
    career = event.get("career") or []
    if career:
        return "★ Career mail", f"{', '.join(career)} · {where}", True
    count = event.get("count", 1)
    senders = event.get("senders") or []
    who = ", ".join(senders) if senders else f"{count} new"
    if count > len(senders) and senders:
        who += f" +{count - len(senders)} more"
    return "New mail", f"{who} · {where}", False


def desktop_alert(title: str, body: str) -> None:
    try:
        subprocess.run(
            ["notify-send", "--urgency=critical", "--app-name=Email TUI", title, body],
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def total(method: str) -> tuple[int | None, dict[str, str]]:
    accounts = call(method)
    return sum(a["unread"] for a in accounts), {a["account"]: a["name"] for a in accounts}


def watch(pending: queue.Queue) -> None:
    while True:
        try:
            for event in events():
                pending.put(event)
        except (BridgeError, OSError, ValueError):
            pass
        time.sleep(RETRY_SECONDS)


def main() -> None:
    state = Path(os.environ.get("HERDR_PLUGIN_STATE_DIR", Path.home() / ".local/state/email-tui"))
    state.mkdir(parents=True, exist_ok=True)
    lock = open(state / "notifier.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # Already running.

    pending: queue.Queue = queue.Queue()
    threading.Thread(target=watch, args=(pending,), daemon=True).start()
    names: dict[str, str] = {}
    failures = 0
    while True:
        try:
            mail, names = total("unread")
        except BridgeError:
            mail = None
        try:
            career = total("career")[0] if mail is not None else None
        except BridgeError:
            career = None  # An older add-on without the career count.
        spaces = workspaces()
        if spaces is None:
            # The herdr server is gone, so stop until its next startup hook.
            failures += 1
            if failures >= MAX_HERDR_FAILURES:
                return
        else:
            failures = 0
            for args in badge_calls(spaces, wanted_tokens(mail, career)):
                herdr(*args)
        try:
            event = pending.get(timeout=REFRESH_SECONDS if mail is not None else RETRY_SECONDS)
        except queue.Empty:
            continue
        if event.get("event") == "new_mail":
            title, body, is_career = toast(event, names)
            sound = "request" if is_career else "none"
            herdr("notification", "show", title, "--body", body, "--sound", sound)
            if is_career:
                desktop_alert(title, body)


if __name__ == "__main__":
    main()
