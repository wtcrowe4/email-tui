#!/usr/bin/env bash
# Run at herdr startup by the plugin. herdr restores workspaces and their last
# screen, but not the programs that were running in them, so the old screen can
# look live when it isn't. This starts the program again in each named
# workspace's first pane, but only when that pane is sitting at a plain shell.
#
# Workspaces and commands, one per line: "<workspace label>=<command>".
# Override with ~/.config/email-tui/autopanes.conf.
set -uo pipefail
conf="${XDG_CONFIG_HOME:-$HOME/.config}/email-tui/autopanes.conf"
default=$'Messages=beeper-tui\nEmail=rail'
herdr="${HERDR_BIN_PATH:-herdr}"
export PATH="$HOME/.local/bin:$PATH"

entries="$default"
[ -f "$conf" ] && entries="$(grep -v '^\s*#' "$conf")"

ready() {   # program can start without needing setup first
  case "$1" in
    rail) [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/rail/config.toml" ] ;;
    *) command -v "${1%% *}" >/dev/null ;;
  esac
}

# Wait for the restored session to come up.
for _ in $(seq 30); do
  "$herdr" workspace list >/dev/null 2>&1 && break
  sleep 1
done
sleep 2

while IFS='=' read -r label cmd; do
  [ -n "$label" ] && [ -n "$cmd" ] || continue
  ready "$cmd" || continue
  pane="$("$herdr" workspace list 2>/dev/null | python3 -c '
import json, sys
label = sys.argv[1]
for w in json.load(sys.stdin)["result"]["workspaces"]:
    if w["label"] == label:
        print(w["active_tab_id"].split(":")[0]); break' "$label")"
  [ -n "$pane" ] || continue
  pane_id="$("$herdr" pane list 2>/dev/null | python3 -c '
import json, sys
ws = sys.argv[1]
for p in json.load(sys.stdin)["result"]["panes"]:
    if p["workspace_id"] == ws:
        print(p["pane_id"]); break' "$pane")"
  [ -n "$pane_id" ] || continue
  fg="$("$herdr" pane process-info --pane "$pane_id" 2>/dev/null | python3 -c '
import json, sys
procs = json.load(sys.stdin)["result"]["process_info"]["foreground_processes"]
print(procs[0]["name"] if procs else "")')"
  case "$fg" in
    bash|zsh|fish|sh|"") "$herdr" pane run "$pane_id" "$cmd" >/dev/null 2>&1 ;;
  esac
done <<< "$entries"
