{
  "manifest_version": 3,
  "name": "Email TUI Bridge",
  "version": "0.4.0",
  "description": "Local bridge from Thunderbird to terminal tools. It can read and organise mail, manage folders, tags, contacts and signatures, and save drafts. It cannot send mail.",
  "browser_specific_settings": {
    "gecko": {
      "id": "email-tui-bridge@wtcrowe4.github.io",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "accountsIdentities",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "compose",
    "messages.save",
    "addressBooks",
    "nativeMessaging",
    "alarms"
  ]
}
